{
  "name": "dsh-plugin-cohere",
  "version": "0.1.10",
  "description": "DSH native model provider for the Cohere v2 Chat API (https://api.cohere.com/v2/chat) — direct wire adapter, no proxy.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "llm",
    "model-provider",
    "cohere"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "author": "cn47mp <233@cn47mp.moe>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/cn47mp/dsh-plugin-cohere.git"
  },
  "bugs": {
    "url": "https://github.com/cn47mp/dsh-plugin-cohere/issues"
  },
  "homepage": "https://github.com/cn47mp/dsh-plugin-cohere#readme",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json && node scripts/copy-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "~3.18.4",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
